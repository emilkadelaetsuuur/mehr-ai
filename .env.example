# Copy to .env and fill in. Never commit .env.
VOICELAB_API_KEY=vlk_...
VOICELAB_LLM_MODEL=aisha-gemma-4
VOICELAB_VOICE_UZ=
VOICELAB_VOICE_RU=
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me
DEMO_PASSWORD=
PUBLIC_URL=http://localhost:18700
DISTRICT_NAME=Namuna tumani
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Claude words the closing of a call from the patient's own answers (optional; without a key the fixed phrase is used)
ANTHROPIC_API_KEY=
# Only when the key belongs to a gateway rather than to Anthropic itself: the gateway's address
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-opus-5-5
# Languages Claude writes the closing in. Elsewhere, and when Claude is late, the VoiceLab model writes it.
CLAUDE_LANGS=uz,ru
# Real phone line (optional): any Twilio-compatible voice API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
