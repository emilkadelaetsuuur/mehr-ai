# Скопируйте в .env и заполните. Файл .env в репозиторий не добавляется.
# Комментарии — только на отдельных строках: docker compose и deploy/release.sh читают значение целиком.

# ---------- Обязательно ----------
POSTGRES_PASSWORD=change-me
# Ключ подписи сессий
SECRET_KEY=change-me
# Пароль четырёх демо-учёток (rahbar, mutaxassis, shifokor, hamshira); пусто — вход без пароля
DEMO_PASSWORD=
# Адрес, который попадёт в ссылки и QR-коды звонков
PUBLIC_URL=http://localhost:18700
DISTRICT_NAME=Namuna tumani

# ---------- Речь: VoiceLab (распознавание, озвучка, языковая модель) ----------
# Без ключа система работает: вместо речи вводится текст, в звонке работают кнопки.
VOICELAB_API_KEY=
VOICELAB_LLM_MODEL=aisha-gemma-4
VOICELAB_VOICE_UZ=
VOICELAB_VOICE_RU=

# ---------- Claude: заключительные слова звонка по ответам пациента (необязательно) ----------
# Без ключа звучит готовая фраза из сценария.
ANTHROPIC_API_KEY=
# Только если ключ выдан шлюзом, а не самой Anthropic
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-opus-5-5
# На других языках и когда Claude опаздывает, текст пишет модель VoiceLab
CLAUDE_LANGS=uz,ru

# ---------- DMED: национальная платформа, HL7 FHIR ----------
# Пока адрес пуст, обмен идёт с тестовой средой внутри системы (страница «DMED»).
DMED_BASE_URL=
DMED_TOKEN=
# Ключ, который DMED предъявляет, отправляя события сюда
DMED_INBOUND_KEY=
# Система идентификатора ПИНФЛ: взять из руководства платформы
DMED_PINFL_SYSTEM=urn:uz:pinfl

# ---------- Уведомления в Telegram (необязательно) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Телефония (необязательно) ----------
# Номер поликлиники для пациента, который просит соединить с человеком
CLINIC_PHONE=
# Ключ стенда «Android-телефон с SIM-картой» (тот же ключ — у gateway/gateway.py)
GATEWAY_KEY=
# Любой голосовой API, совместимый с Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
